# Run outputs (transcripts may contain confidential meeting content)
outputs/*
!outputs/.gitkeep

# Local model caches
models/
.cache/

# Media files anywhere in the repo
*.wav
*.mp3
*.m4a
*.mp4
*.mov
*.flac
*.npy

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
