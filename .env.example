# Copy to .env and fill in. .env is git-ignored. Never commit a real token.

# Hugging Face read token (https://hf.co/settings/tokens).
# Required to download the gated pyannote/speaker-diarization-community-1 pipeline.
# You must first accept the model conditions at https://hf.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Azure Speech (Microsoft Foundry) resource used for MAI-Transcribe-2 speech-to-text.
# Easiest: UI "시스템 진단" tab > Azure MAI 연결 설정 (paste the portal resource URL + key, saved here)
#      or: meeting-transcriber azure-setup "<portal resource URL | endpoint>"
# Endpoint: Azure portal > your Foundry/Speech resource > Keys and Endpoint
#   e.g. https://<resource-name>.cognitiveservices.azure.com  (portal resource URL / resource name also accepted)
# The resource must be in a region that offers MAI-Transcribe (see README).
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=

# Optional: path to a YAML config overriding config/default.yaml
# MT_CONFIG=config/local.yaml

# Optional overrides (MT_<SECTION>__<KEY>, case-insensitive). Examples:
# MT_RUNTIME__DEVICE=cuda
# MT_ASR__BACKEND=whisperx          # fully local speech-to-text instead of Azure MAI
# MT_ASR__MODEL=large-v3-turbo
# MT_ASR__COMPUTE_TYPE=int8_float16
# MT_ASR__BATCH_SIZE=8
# MT_DIARIZATION__MAX_SPEAKERS=10
# MT_SPEAKER_ID__MATCH_THRESHOLD=0.5
# MT_PATHS__ENROLLMENT_DIR=data/speakers
# MT_PATHS__OUTPUT_DIR=outputs

# Optional: where WeSpeaker stores downloaded pretrained models (default ~/.wespeaker)
# WESPEAKER_HOME=

# After all models are cached locally you can force fully-offline operation:
# HF_HUB_OFFLINE=1
